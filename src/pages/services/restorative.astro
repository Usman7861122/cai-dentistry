---
import ServicePageLayout from "../../components/ServicePageLayout.astro";
import { ShieldCheck, Move, Wrench, Layers } from "lucide-react";

const treatments = [
  {
    icon: ShieldCheck,
    name: "Dental Implants",
    description: "Permanent, natural-looking replacements for missing teeth.",
  },
  {
    icon: Move,
    name: "Invisalign & Aligners",
    description: "Straighten teeth discreetly with clear, removable aligners.",
  },
  {
    icon: Wrench,
    name: "Cosmetic Bonding",
    description: "Fast, affordable fixes for chips, gaps, and small cracks.",
  },
  {
    icon: Layers,
    name: "Dental Crowns",
    description: "Restore strength and shape to a damaged or weakened tooth.",
  },
];
---

<ServicePageLayout
  pageTitle="Restorative Dentistry | CAI Dentistry"
  description="Implants, crowns, aligners, and bonding at CAI Dentistry in Pasadena, CA."
  heroImage="/images/jonathan-borba-hl6uG9cHW5A-unsplash.jpg"
  eyebrow="Our Services"
  heroTitle="Restorative Dentistry"
  heroSubtitle="Implants, crowns, and repairs that restore strength, shape, and confidence."
>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="grid gap-8 sm:grid-cols-2">
      {treatments.map((t) => {
        const Icon = t.icon;
        return (
          <div class="rounded-2xl border border-ink/8 bg-white p-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-teal-light text-teal-dark">
              <Icon className="h-6 w-6" />
            </div>
            <h3 class="mt-5 font-display text-xl text-ink">{t.name}</h3>
            <p class="mt-2 text-sm text-ink-soft">{t.description}</p>
          </div>
        );
      })}
    </div>
  </section>

  <section class="bg-teal-light py-16 text-center">
    <h2 class="font-display text-3xl text-ink">Ready to restore your smile?</h2>
    <p class="mt-3 text-ink-soft">Book a consultation and we will find the right fix for you.</p>
    <a
      href="/#appointment"
      class="mt-6 inline-block rounded-full bg-teal px-7 py-3 text-sm font-semibold text-cream transition-colors hover:bg-teal-dark"
    >
      Book a Consultation
    </a>
  </section>
</ServicePageLayout>
