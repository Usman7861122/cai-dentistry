---
import ServicePageLayout from "../../components/ServicePageLayout.astro";
import { Stethoscope, Droplet, Activity, ShieldPlus } from "lucide-react";

const treatments = [
  {
    icon: Stethoscope,
    name: "Exams & Cleanings",
    description: "Routine checkups and professional cleanings to keep your smile healthy.",
  },
  {
    icon: Droplet,
    name: "Fillings & Repairs",
    description: "Comfortable, tooth-colored fillings that blend right in.",
  },
  {
    icon: Activity,
    name: "Root Canal Therapy",
    description: "Gentle treatment that saves a damaged or infected tooth.",
  },
  {
    icon: ShieldPlus,
    name: "Preventive Care",
    description: "Digital X-rays, sealants, and guards to protect your smile long-term.",
  },
];
---

<ServicePageLayout
  pageTitle="General Dentistry | CAI Dentistry"
  description="Checkups, cleanings, fillings, and preventive care at CAI Dentistry in Pasadena, CA."
  heroImage="/images/caroline-lm-ux18C551ghI-unsplash.jpg"
  eyebrow="Our Services"
  heroTitle="General Dentistry"
  heroSubtitle="Routine checkups and cleanings that keep your smile healthy year-round."
>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="grid gap-8 sm:grid-cols-2">
      {treatments.map((t) => {
        const Icon = t.icon;
        return (
          <div class="rounded-2xl border border-ink/8 bg-white p-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-teal-light text-teal-dark">
              <Icon className="h-6 w-6" />
            </div>
            <h3 class="mt-5 font-display text-xl text-ink">{t.name}</h3>
            <p class="mt-2 text-sm text-ink-soft">{t.description}</p>
          </div>
        );
      })}
    </div>
  </section>

  <section class="bg-teal-light py-16 text-center">
    <h2 class="font-display text-3xl text-ink">Due for a checkup?</h2>
    <p class="mt-3 text-ink-soft">Book a visit and keep your smile healthy year-round.</p>
    <a
      href="/#appointment"
      class="mt-6 inline-block rounded-full bg-teal px-7 py-3 text-sm font-semibold text-cream transition-colors hover:bg-teal-dark"
    >
      Book a Consultation
    </a>
  </section>
</ServicePageLayout>
