---
// Full-bleed 3-photo category strip, styled after honetderm.com's homepage
// section: edge-to-edge grayscale photos, a bottom gradient for legibility,
// a thin white icon, and an uppercase label. Category names and icons are
// adapted for a dental practice instead of a medspa's (Injectables/Cosmetic/
// Medical). Hovering reveals a short description beneath the title. No JS
// framework needed here -- it's just CSS hover/transition, so this stays a
// plain, fast Astro component (no client:* directive).
const categories = [
  {
    label: "Cosmetic",
    description: "Veneers, whitening, and smile makeovers designed to look completely natural.",
    image: "/images/amr-taha-FMcKJXPQtY0-unsplash.jpg",
    href: "#services",
  },
  {
    label: "Restorative",
    description: "Implants, crowns, and repairs that restore strength, shape, and confidence.",
    image: "/images/jonathan-borba-hl6uG9cHW5A-unsplash.jpg",
    href: "#services",
  },
  {
    label: "General",
    description: "Routine checkups and cleanings that keep your smile healthy year-round.",
    image: "/images/caroline-lm-ux18C551ghI-unsplash.jpg",
    href: "#services",
  },
];
---

<section id="services" class="grid grid-cols-1 sm:grid-cols-3">
  {
    categories.map((category) => (
      <a
        href={category.href}
        class="group relative block h-[420px] overflow-hidden sm:h-[70vh] sm:max-h-[720px]"
      >
        <img
          src={category.image}
          alt={category.label}
          class="absolute inset-0 h-full w-full scale-100 object-cover grayscale transition-all duration-700 ease-out group-hover:scale-105 group-hover:grayscale-0"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-transparent transition-colors duration-500 group-hover:from-black/80" />
        <div class="absolute inset-0 flex flex-col items-center justify-end gap-3 px-8 pb-14 text-center text-white">
          {category.label === "Cosmetic" && (
            <svg class="h-11 w-11 transition-transform duration-500 ease-out group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
              <path d="M12 3l1.9 4.5L18 9l-4.1 1.5L12 15l-1.9-4.5L6 9l4.1-1.5L12 3z" />
              <path d="M5 17l.8 1.9L8 20l-2.2.9L5 23l-.8-2.1L2 20l2.2-1.1L5 17z" />
              <path d="M19 17l.7 1.6L21 19l-1.3.8L19 21l-.7-1.2L17 19l1.3-.4L19 17z" />
            </svg>
          )}
          {category.label === "Restorative" && (
            <svg class="h-11 w-11 transition-transform duration-500 ease-out group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
              <path d="M14.7 6.3a3 3 0 0 0-4.24 4.24l1.06 1.06-6.36 6.37a1.5 1.5 0 0 0 2.12 2.12l6.36-6.36 1.06 1.06a3 3 0 0 0 4.24-4.24" />
              <path d="M17 3l1 1" />
              <path d="M19 5l1 1" />
            </svg>
          )}
          {category.label === "General" && (
            <svg class="h-11 w-11 transition-transform duration-500 ease-out group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
              <path d="M6 3v6a4 4 0 0 0 8 0V3" />
              <circle cx="18" cy="6" r="2" />
              <path d="M18 8v3a6 6 0 0 1-12 0" />
              <path d="M6 14v3a2 2 0 0 0 2 2h1" />
            </svg>
          )}
          <span class="font-sans text-lg font-semibold uppercase tracking-[0.25em] transition-transform duration-500 ease-out group-hover:-translate-y-1">
            {category.label}
          </span>
          <p class="max-h-0 max-w-[240px] overflow-hidden text-sm leading-relaxed text-white/90 opacity-0 transition-all duration-500 ease-out group-hover:max-h-24 group-hover:opacity-100">
            {category.description}
          </p>
        </div>
      </a>
    ))
  }
</section>
