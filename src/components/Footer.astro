---
const year = new Date().getFullYear();
---

<footer class="bg-ink text-cream-dark">
  <div class="mx-auto max-w-6xl px-6 py-14 grid gap-10 sm:grid-cols-2 md:grid-cols-4">
    <div>
      <span class="inline-flex items-baseline gap-1.5">
        <span class="font-display text-2xl font-bold tracking-tight text-cream">CAI</span>
        <span class="font-display text-lg italic text-teal-light">Dentistry</span>
      </span>
      <p class="mt-3 text-sm text-cream-dark/70">
        Premier cosmetic dentistry. Beautiful, natural-looking smiles.
      </p>
    </div>

    <div>
      <p class="font-semibold text-cream">Contact</p>
      <ul class="mt-3 space-y-2 text-sm text-cream-dark/80">
        <li>123 Colorado Blvd, Pasadena, CA</li>
        <li><a href="tel:+16265551234" class="hover:text-teal-light">(626) 555-1234</a></li>
        <li><a href="mailto:hello@caidentistry.com" class="hover:text-teal-light">hello@caidentistry.com</a></li>
      </ul>
    </div>

    <div>
      <p class="font-semibold text-cream">Hours</p>
      <ul class="mt-3 space-y-2 text-sm text-cream-dark/80">
        <li>Mon–Fri: 9am – 6pm</li>
        <li>Saturday: 10am – 2pm</li>
        <li>Sunday: Closed</li>
      </ul>
    </div>

    <div>
      <p class="font-semibold text-cream">Follow us</p>
      <ul class="mt-3 space-y-2 text-sm text-cream-dark/80">
        <li><a href="#" class="hover:text-teal-light">Instagram</a></li>
        <li><a href="#" class="hover:text-teal-light">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-cream-dark/10 py-6 text-center text-xs text-cream-dark/50">
    © {year} CAI Dentistry. All rights reserved.
  </div>
</footer>
